{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Enterprise-ready Playwright automation framework with JavaScript for end-to-end testing",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:ui": "playwright test tests/ui",
    "test:mobile": "playwright test tests/mobile",
    "test:visual": "playwright test tests/visual",
    "test:integrated": "playwright test tests/integrated",
    "test:shared-context": "playwright test tests/integrated/shared-context-example.spec.ts",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:safari": "playwright test --project=webkit",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:parallel": "playwright test --workers=4",
    "report": "playwright show-report",
    "report:allure": "allure generate ./allure-results --clean && allure open",
    "ui": "playwright test --ui",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "clean": "rm -rf test-results playwright-report allure-results allure-report",
    "clean:reports": "rm -rf test-results playwright-report",
    "clean:allure": "rm -rf allure-results allure-report",
    "pretest": "npm run clean:reports",
    "test:nocode": "node no-code-runner/cli.js run",
    "test:nocode:validate": "node no-code-runner/cli.js validate"
  },
  "keywords": [
    "playwright",
    "javascript",
    "automation",
    "testing",
    "e2e",
    "api-testing",
    "ui-testing",
    "visual-testing",
    "no-code"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.15.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^0.20.0",
    "prettier": "^3.1.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "pg": "^8.11.3",
    "mongodb": "^6.3.0",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^8.0.0",
    "ajv": "^8.12.0",
    "yargs": "^17.7.2",
    "csv-parse": "^5.5.3",
    "curlconverter": "^4.10.0"
  }
}