{
  "description": "1mg.com locators - These are GENERIC patterns. You need to discover ACTUAL locators!",
  "url": "https://www.1mg.com",
  "homepage": {
    "logo": {
      "selectors": [
        "img[alt*='1mg']",
        "img[title*='1mg']",
        ".logo",
        "a[href='/'] img"
      ],
      "description": "Website logo - verify page loaded"
    },
    "loginButton": {
      "selectors": [
        "text=/Login|Sign Up|Sign In/i",
        "button:has-text('Login')",
        "a:has-text('Login')",
        "[data-test='login-button']",
        ".login-btn"
      ],
      "description": "Login/Sign Up button on homepage"
    }
  },
  "loginModal": {
    "phoneInput": {
      "selectors": [
        "input[type='tel']",
        "input[placeholder*='phone']",
        "input[placeholder*='mobile']",
        "input[name='phone']",
        "input[name='mobile']",
        "#phone",
        "#mobile"
      ],
      "description": "Phone number input field",
      "testData": {
        "valid": "9876543210",
        "invalid_short": "987654321",
        "invalid_long": "98765432100",
        "invalid_chars": "abcd@#$%"
      }
    },
    "submitButton": {
      "selectors": [
        "button:has-text('Send OTP')",
        "button:has-text('Continue')",
        "button[type='submit']",
        ".submit-btn",
        "[data-test='submit-button']"
      ],
      "description": "Submit/Send OTP button"
    },
    "closeButton": {
      "selectors": [
        "button[aria-label*='close']",
        "button:has-text('×')",
        ".close-icon",
        ".modal-close",
        "[data-test='close-modal']"
      ],
      "description": "Close modal button"
    },
    "errorMessage": {
      "selectors": [
        "text=/Invalid|Error|Enter valid|10 digit/i",
        ".error-message",
        ".error-text",
        "[role='alert']",
        ".validation-error"
      ],
      "description": "Error message container"
    }
  },
  "otpScreen": {
    "otpInputs": {
      "selectors": [
        "input[type='tel'][maxlength='1']",
        "input[placeholder*='OTP']",
        "text=/Enter OTP|Verify OTP/i",
        ".otp-input",
        "[data-test='otp-input']"
      ],
      "description": "OTP input fields or screen"
    }
  },
  "howToFindActualLocators": {
    "method1": "Use Playwright Codegen: npx playwright codegen https://www.1mg.com",
    "method2": "Use Browser DevTools: Right-click > Inspect Element",
    "method3": "Use Playwright Inspector: npm run test:debug",
    "method4": "Check element attributes: id, class, data-test, aria-label",
    "method5": "Use the locator-discovery.spec.ts test I'll create below"
  },
  "bestPractices": {
    "priority1": "Use data-test attributes (most stable)",
    "priority2": "Use id attributes",
    "priority3": "Use aria-label or role attributes",
    "priority4": "Use class names (but they may change)",
    "priority5": "Use text content (flexible but fragile)"
  },
  "note": "IMPORTANT: These are GENERIC selectors. The actual 1mg.com selectors may be different!",
  "recommendation": "Run the locator-discovery.spec.ts test I'll create to find actual selectors",
  "warning": "Websites change frequently. Always verify locators work with actual site!"
}