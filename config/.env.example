# Test Environment
TEST_ENV=dev

# Application URLs
BASE_URL=https://example.com
API_BASE_URL=https://api.example.com

# Authentication
AUTH_USERNAME=test_user
AUTH_PASSWORD=test_password
API_KEY=your_api_key_here

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=test_db
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_SSL=false
POSTGRES_MAX_POOL_SIZE=10
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=5000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
# OR use individual parameters (if URI is not set)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=test_user
MONGO_PASSWORD=test_password
MONGO_DB=test_db
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
MONGO_CONNECT_TIMEOUT=10000
MONGO_SOCKET_TIMEOUT=45000

# Legacy DB Config (for backward compatibility)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password

# Order Nexus Configuration (if applicable)
ORDER_NEXUS_BASE_URL=https://staginternalapi.1mg.com
STAG_ORDER_NEXUS_TOKEN=your_order_nexus_token_here
ORDER_NEXUS_API_VERSION=v1